              "examples/ceo-monday-brief",
              "examples/release-train"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "Foundations",
            "pages": [
              "architecture/layers",
              "architecture/forward-compat-invariants",
              "architecture/l0-decisions",
              "architecture/admission"
            ]
          },
          {
            "group": "Decisions",
            "pages": [
              "architecture/adrs"
            ]
          }
        ],
        "icon": "layer-group"
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "YAML",
            "pages": [
              "reference/yaml-syntax",
              "reference/schema"
            ]
          },
          {
            "group": "CLI & errors",
            "pages": [
              "reference/cli",
              "reference/machine-surfaces",
