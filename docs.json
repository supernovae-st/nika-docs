            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "reference/status",
              "reference/constellation",
              "reference/design-system"
            ]
          }
        ],
        "icon": "code"
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Cadence",
            "pages": [
              "changelog/releases",
              "changelog/roadmap"
            ]
          }
        ],
        "icon": "clock-rotate-left"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "fonts": {
    "family": "Inter"
  },
  "seo": {
    "metatags": {
      "og:image": "https://docs.nika.sh/images/og-card.png",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    {
      "source": "/errors",
      "destination": "/reference/error-codes"
    },
    {
      "source": "/errors/:code*",
      "destination": "/reference/error-codes"
    }
  ]
}