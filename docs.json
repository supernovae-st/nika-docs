{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Nika",
  "description": "Documentation for Nika — the AGPL workflow engine for AI. Semantic YAML, Rust, runs on your laptop.",
  "theme": "mint",
  "logo": {
    "dark": "/images/logo-dark.svg",
    "light": "/images/logo-light.svg",
    "href": "https://nika.sh"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#2f6bff",
    "light": "#8db4ff",
    "dark": "#2f6bff"
  },
  "customCss": "/global.css",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#08090b",
      "light": "#F4F6FC"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "layout": {
    "tocPosition": "right",
    "breadcrumbs": true,
    "tocDepth": 3
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": {
    "prompt": "Search Nika docs…"
  },
  "metadata": {
    "og:image": "https://docs.nika.sh/images/og-default.png",
    "og:type": "website",
    "twitter:card": "summary_large_image"
  },
  "banner": {
    "content": "🦋 Project arming and the resident firer are live. `nika.yaml` proposes; the machine disposes. [Read the current status →](/reference/status)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "nika.sh",
        "href": "https://nika.sh"
