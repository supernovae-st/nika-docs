{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Nika",
  "description": "Documentation for Nika — the AGPL workflow engine for AI. Semantic YAML, Rust, runs on your laptop.",
  "theme": "mint",
  "logo": {
    "dark": "/images/logo-dark.svg",
    "light": "/images/logo-light.svg",
    "href": "https://nika.sh"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#2f6bff",
    "light": "#8db4ff",
    "dark": "#2f6bff"
  },
  "customCss": "/global.css",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#08090b",
      "light": "#F4F6FC"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "layout": {
    "tocPosition": "right",
    "breadcrumbs": true,
    "tocDepth": 3
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": {
    "prompt": "Search Nika docs…"
  },
  "metadata": {
    "og:image": "https://docs.nika.sh/images/og-default.png",
    "og:type": "website",
    "twitter:card": "summary_large_image"
  },
  "banner": {
    "content": "🦋 Nika is out: `brew install supernovae-st/tap/nika` runs today. 1.0 + Product Hunt: August 1. [Changelog →](/changelog/releases)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "nika.sh",
        "href": "https://nika.sh"
      },
      {
        "type": "github",
        "href": "https://github.com/supernovae-st/nika"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/getting-started/installation"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/supernovae-st/nika",
      "x": "https://x.com/ThibautMelen"
    },
    "links": [
      {
        "header": "Nika",
        "items": [
          {
            "label": "Site",
            "href": "https://nika.sh"
          },
          {
            "label": "Live state",
            "href": "/reference/status"
          },
          {
            "label": "Constellation",
            "href": "/reference/constellation"
          }
        ]
      },
      {
        "header": "Build",
        "items": [
          {
            "label": "Language spec (Apache-2.0)",
            "href": "https://github.com/supernovae-st/nika-spec"
          },
          {
            "label": "Source (AGPL)",
            "href": "https://github.com/supernovae-st/nika"
          },
          {
            "label": "TypeScript SDK",
            "href": "https://github.com/supernovae-st/nika-client"
          },
          {
            "label": "Homebrew tap",
            "href": "https://github.com/supernovae-st/homebrew-tap"
          }
        ]
      },
      {
        "header": "Studio",
        "items": [
          {
            "label": "SuperNovae",
            "href": "https://supernovae.studio"
          }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction"
